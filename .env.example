# Core runtime
NODE_ENV=development
PORT=5000
WS_PORT=5001
SIGNALING_PORT=5000
MEDIA_RELAY_PORT=41000
SESSION_SECRET=replace-with-32-plus-random-characters
PLATFORM_SECRET_KEY=
DATABASE_URL=postgresql://user:password@host:5432/neuratalk?sslmode=require
REDIS_URL=redis://localhost:6379
ALLOW_DEGRADED_STARTUP=false
USE_REMOTE_REDIS=false
DOTENV_OVERRIDE=false
ALLOW_ENV_CONFLICTS=false
REDIS_REQUIRED_STARTUP=false
TRUSTED_PROXIES=
ENABLE_STARTUP_SEEDING=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=

# Public app URLs
APP_BASE_URL=https://api.your-domain.com
BASE_URL=https://app.your-domain.com
FRONTEND_URL=https://app.your-domain.com
ALLOWED_ORIGINS=https://app.your-domain.com

REPL_ID=
REPL_OWNER=
REPL_SLUG=

# Auth â€” Firebase Phone Auth (sole mobile OTP method)
# No dummy OTP, no SMS fallback. Firebase is always required for phone login.
PHONE_OTP_PROVIDER=firebase
VITE_PHONE_OTP_PROVIDER=firebase
MSG91_AUTH_KEY=
MSG91_VOICE_CALLER_ID=
MSG91_VOICE_URL=
MSG91_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_EMAIL_FROM=auth@your-domain.com

# Firebase web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase admin
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# AI / OpenAI
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VOICE_ASSISTANT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_REALTIME_TRANSLATION_MAX_TOKENS=192
OPENAI_VOICE_ASSISTANT_MAX_TOKENS=96
FAST_PATH=true
PREFER_LOCAL_AI=false
ULTRA_LOW_LATENCY=false
ENABLE_VOICE_CLONING=false

# Local AI endpoints
LOCAL_WHISPER_URL=http://localhost:8080/transcribe
LOCAL_TRANSLATION_URL=http://localhost:8081/translate
LOCAL_EMOTION_URL=http://localhost:8082/emotion
LOCAL_RVC_URL=http://localhost:8083/convert
LOCAL_XTTS_URL=http://localhost:8084/synthesize
LOCAL_PROSODY_URL=http://localhost:8085/analyze
STREAMING_STT_URL=ws://localhost:8090/stream-stt
STREAMING_TRANSLATION_URL=ws://localhost:8091/stream-translate
STREAMING_TTS_URL=ws://localhost:8092/stream-tts

# Voice / translation providers
DEEPGRAM_API_KEY=
STT_PROVIDER=azure
ENABLE_DEEPGRAM_STT_FALLBACK=true
AZURE_STREAMING_STT_FLUSH_INTERVAL_MS=700
AZURE_STREAMING_STT_MAX_BUFFER_MS=6000
AZURE_STREAMING_STT_MIN_AUDIO_MS=320
AZURE_STREAMING_STT_TIMEOUT_MS=5000
ENABLE_LEGACY_SIGNALING_WS=false
VITE_ENABLE_LEGACY_MEETING_TRANSPORT=false
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_ENDPOINTING_MS=120
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
ELEVEN_LABS_API_KEY=
ELEVENLABS_API_KEY=

# LiveKit / RTC / TURN
LIVEKIT_URL=wss://livekit.your-domain.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_SIP_DOMAIN=sip.livekit.your-domain.com
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
COMMUNICATION_MASKING_TTL_MINUTES=120
ENABLE_LEGACY_TWILIO_BRIDGE=false
SMART_CALL_PROVIDER_TIMEOUT_ACTIVE_MS=60000
SMART_CALL_PROVIDER_TIMEOUT_RINGING_MS=90000
SMART_CALL_MEDIA_HEARTBEAT_INTERVAL_MS=15000
SMART_CALL_MEDIA_STALL_WARN_MS=30000
TRANSLATOR_BOT_TTS_READY_TIMEOUT_MS=4000

# Agora / telecom legacy
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CLOUD_RECORDING_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TRIAL=false

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Voice assistant runtime
VOICE_ASSISTANT_TARGET_LATENCY_MS=800
VOICE_ASSISTANT_MAX_CONTEXT_TURNS=6
VOICE_ASSISTANT_MIN_PARTIAL_WORDS=1
VOICE_ASSISTANT_RESTART_DELTA=4
VOICE_ASSISTANT_ENABLE_PRECACHE=true
VOICE_ASSISTANT_SYSTEM_PROMPT=You are NeuraTalk Voice Assistant. Reply in short spoken sentences for live audio.

# Translator bot runtime
TRANSLATOR_BOT_TARGET_LATENCY_MS=800
TRANSLATOR_BOT_MIN_PARTIAL_WORDS=1
TRANSLATOR_BOT_RESTART_DELTA=4
TRANSLATOR_BOT_VAD_THRESHOLD=0.018
TRANSLATOR_BOT_SILENCE_RESET_FRAMES=6
TRANSLATOR_BOT_ENABLE_LANGUAGE_DETECT=true
TRANSLATOR_BOT_ENABLE_PRECACHE=true

# Face-to-face runtime
FACE_TO_FACE_TARGET_LATENCY_MS=900
FACE_TO_FACE_MIN_PARTIAL_WORDS=1
FACE_TO_FACE_RESTART_DELTA=4
FACE_TO_FACE_VAD_THRESHOLD=0.014
FACE_TO_FACE_SILENCE_RESET_FRAMES=8

# Platform / observability
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Inbound call handling
NEURATALK_INBOUND_NUMBER=

