node_modules
# dist is a generated build artifact -- DigitalOcean now runs "npm run build"
# during deployment (.do/app.yaml build_command). Committing dist/ was the
# root cause of a real incident: see
# docs/neura-ecosystem/20_PRODUCTION_DEPLOYMENT_INTEGRITY_AUDIT.md.
# Never re-commit it -- if you find yourself running `git add dist/`, stop.
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Local tools / editor state
.agents/
.claude/
.local/
.neon/
.neon
.vscode/

# Environment files
.env
.env.*
!.env.example

# Secrets / service accounts
*.jks
*.keystore
key.properties
*service-account*.json
!*service-account*.example.json
*credentials*.json
!*credentials*.example.json
*.pem
*.key
!*.pub.key
firebase-adminsdk-*.json
neuratalk-release-key.jks

# Replit platform files — not part of production deployment
.replit
replit.nix

# Replit paste/attachment dumps (often contain pasted secrets)
attached_assets/Pasted-*

# Backup dumps / data snapshots with platform_secrets or user data
backups/
!backups/**/config/
!backups/**/BACKUP_MANIFEST.txt
backups/**/database/*.sql
backups/**/database/*.sql.gz

# Logs
*.log
dev_error.log
server_err.txt
server_out.txt
/tmp/
.tmp/
flutter_app/*.txt
flutter_app/*_log*.txt

# Test/coverage output (regenerated by npm run test:coverage / test:e2e)
/coverage/
/test-results/

# Gradle home caches (local build tool cache, not source code)
.gradle-home/
mobile/android/.gradle-home/
mobile/android/.gradle/
mobile/node_modules/
mobile/android/app/debug.keystore

# Build outputs and local crash artifacts
build/
flutter_app/build/
flutter_app/android/.gradle/
flutter_app/android/build/
flutter_app/android/local.properties
flutter_app/android/key.properties
*.apk
*.aab
*.hprof
hs_err_pid*.log
replay_pid*.log
