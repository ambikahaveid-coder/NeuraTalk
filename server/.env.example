# 🚨 STEP 1: Update these with your actual credentials
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=production
APP_BASE_URL=https://api.yourdomain.com
REDIS_URL=redis://localhost:6379

# ============================================
# 🔐 RAZORPAY (Payment Processing)
# ============================================
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ============================================
# 🔥 FIREBASE (Authentication & Backend)
# ============================================
# Download JSON from Firebase Console → Project Settings
PHONE_OTP_PROVIDER=firebase
VITE_PHONE_OTP_PROVIDER=firebase
VITE_FIREBASE_API_KEY=xxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=neuratalk-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neuratalk-prod
VITE_FIREBASE_STORAGE_BUCKET=neuratalk-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"neuratalk-prod"}
FIREBASE_PROJECT_ID=neuratalk-prod
FIREBASE_DATABASE_URL=https://neuratalk-prod.firebaseio.com

# ============================================
# 📊 MONGODB (Database)
# ============================================
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/neuratalk

# ============================================
# 🤖 OPENAI (Speech Recognition)
# ============================================
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VOICE_ASSISTANT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_REALTIME_TRANSLATION_MAX_TOKENS=192
OPENAI_VOICE_ASSISTANT_MAX_TOKENS=96

# ============================================
# AZURE (Speech / Translation)
# ============================================
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=xxxxxxxxxxxxxxxx
AZURE_TRANSLATOR_REGION=centralindia

# ============================================
# 🎙️ ELEVENLABS (Voice Cloning)
# ============================================
# Get from: https://api.elevenlabs.io
ELEVEN_LABS_API_KEY=xxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxx

# ============================================
# 🔐 JWT Secret
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# 📱 TWILIO (SMS for OTP) - Optional
# ============================================
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
MSG91_OTP_TEMPLATE_ID=xxxxxxxxxxxxxxxx
MSG91_VOICE_CALLER_ID=+919876543210
MSG91_VOICE_URL=https://yourdomain.com/api/msg91/voice

# ============================================
# EMAIL OTP DELIVERY
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
OTP_EMAIL_FROM=auth@yourdomain.com

# ============================================
# LIVEKIT (Realtime Media)
# ============================================
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=xxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_SIP_DOMAIN=sip.livekit.yourdomain.com
COMMUNICATION_MASKING_TTL_MINUTES=120
ENABLE_LEGACY_TWILIO_BRIDGE=false

# ============================================
# OPTIONAL PROVIDERS
# ============================================
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxx
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_ENDPOINTING_MS=120
AGORA_APP_ID=xxxxxxxxxxxxxxxx
AGORA_APP_CERTIFICATE=xxxxxxxxxxxxxxxx
AGORA_CLOUD_RECORDING_ENABLED=false

# ============================================
# VOICE ASSISTANT RUNTIME
# ============================================
VOICE_ASSISTANT_TARGET_LATENCY_MS=800
VOICE_ASSISTANT_MAX_CONTEXT_TURNS=6
VOICE_ASSISTANT_MIN_PARTIAL_WORDS=1
VOICE_ASSISTANT_RESTART_DELTA=4
VOICE_ASSISTANT_ENABLE_PRECACHE=true
VOICE_ASSISTANT_SYSTEM_PROMPT=You are NeuraTalk Voice Assistant. Reply in short spoken sentences for live audio.

TRANSLATOR_BOT_TARGET_LATENCY_MS=800
TRANSLATOR_BOT_MIN_PARTIAL_WORDS=1
TRANSLATOR_BOT_RESTART_DELTA=4
TRANSLATOR_BOT_VAD_THRESHOLD=0.018
TRANSLATOR_BOT_SILENCE_RESET_FRAMES=6
TRANSLATOR_BOT_ENABLE_LANGUAGE_DETECT=true
TRANSLATOR_BOT_ENABLE_PRECACHE=true

FACE_TO_FACE_TARGET_LATENCY_MS=900
FACE_TO_FACE_MIN_PARTIAL_WORDS=1
FACE_TO_FACE_RESTART_DELTA=4
FACE_TO_FACE_VAD_THRESHOLD=0.014
FACE_TO_FACE_SILENCE_RESET_FRAMES=8
TRANSLATOR_BOT_ENABLE_PRECACHE=true

# ============================================
# 🌐 CORS Configuration
# ============================================
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
