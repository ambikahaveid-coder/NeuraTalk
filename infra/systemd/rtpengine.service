[Unit]
Description=NeuraTalk RTPEngine Media Proxy
Documentation=https://github.com/sipwise/rtpengine
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
Group=root

EnvironmentFile=/etc/default/rtpengine

ExecStartPre=/bin/mkdir -p /var/run/rtpengine
ExecStart=/usr/sbin/rtpengine \
    --config-file=/etc/rtpengine/rtpengine.conf \
    --pidfile=/var/run/rtpengine/rtpengine.pid \
    --foreground=false

ExecStop=/bin/kill -TERM $MAINPID

PIDFile=/var/run/rtpengine/rtpengine.pid

Restart=always
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5

# RTPEngine needs large port range and raw socket access
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_NICE

# For kernel mode (bare metal): needs IPC_LOCK too
# AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_NICE CAP_IPC_LOCK

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rtpengine

[Install]
WantedBy=multi-user.target
