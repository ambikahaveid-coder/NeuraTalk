[Unit]
Description=NeuraTalk Kamailio SIP Core
Documentation=https://www.kamailio.org/w/documentation/
After=network-online.target rtpengine.service
Wants=network-online.target
# Require RTPEngine to be up before Kamailio starts
# (Kamailio will try to connect to RTPEngine ng port on startup)
Requires=rtpengine.service

[Service]
Type=forking
User=root
Group=root

# Environment file — populated by install.sh
EnvironmentFile=/etc/default/kamailio

# Binary + config
ExecStartPre=/usr/sbin/kamailio -c -f /etc/kamailio/kamailio.cfg
ExecStart=/usr/sbin/kamailio \
    -f /etc/kamailio/kamailio.cfg \
    -P /var/run/kamailio/kamailio.pid \
    -DD \
    -E \
    -e

ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

PIDFile=/var/run/kamailio/kamailio.pid

# Restart policy
Restart=always
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5

# Resource limits — high for SIP proxy
LimitNOFILE=65536
LimitNPROC=32768
LimitCORE=infinity

# Capabilities needed for binding low ports and raw sockets
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_NICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kamailio

[Install]
WantedBy=multi-user.target
