##############################################################################
# NeuraTalk SIP Infrastructure — Environment Variables
# Copy to .env and fill in real values before running docker compose
##############################################################################

# ── Network ───────────────────────────────────────────────────────────────
# Public IP of the SIP server (DO Droplet public IP)
KAMAILIO_PUBLIC_IP=1.2.3.4

# Private/LAN IP (same as public if no internal network)
KAMAILIO_PRIVATE_IP=10.0.0.2

# SIP domain (must have A record pointing to KAMAILIO_PUBLIC_IP)
KAMAILIO_DOMAIN=sip.neuratalk.in

# ── Downstream Services ────────────────────────────────────────────────────
# RTPEngine ng protocol address
RTPENGINE_HOST=127.0.0.1:22222

# FreeSWITCH B2BUA (if deployed; leave blank to disable)
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=5080

# NeuraTalk Node.js API (for DID lookup, webhook processing)
NEURATALK_API_HOST=app.neuratalk.in:443

# ── Database (optional — for multi-node usrloc persistence) ──────────────
# If not set, Kamailio uses in-memory registration (fine for single-node)
KAMAILIO_DB_URL=

# ── TLS ────────────────────────────────────────────────────────────────────
# Directory containing cert.pem, key.pem, ca.pem
TLS_CERT_DIR=/etc/letsencrypt/live/sip.neuratalk.in

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production
GRAFANA_URL=https://metrics.neuratalk.in

# ── Logging ────────────────────────────────────────────────────────────────
# 1=crit, 2=error, 3=warn, 4=info, 5=debug
KAMAILIO_LOG_LEVEL=3
